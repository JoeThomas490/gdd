---
import { XIcon } from "@lucide/astro"
---

<div id="about">
    <a class="about-center-close" href="#"/>
    <div class="about-center">
        <div class="about-container">
            <h2> About </h2>    
            <p>
                Game Dev Directory is an ever-growing index of game developers from all over the world.
            </p> 
            <p>
                Ranging from AAA, Indie and Hobbyist developers, this page is a route into each persons portfolio.
            </p>
            <p>
                Created by joenoseph and Two Wools Studio
            </p>
            <p>
                Any issues? Drop us an email!
            </p>
            <a class="about-close" href="#">
                <XIcon size={16}/>
            </a>
        </div> 
    </div>
</div>

<style>

    h2 {
        font-family: var(--font-crimson);
        font-weight: 600;
        font-size: 28px;
        margin: 0;
        margin-bottom: 10px;
    }

    p {
        font-family: var(--font-crimson);
        font-weight: 400;
        font-size: 16px;
        margin-bottom: 10px;
    }

	#about {
		display: none;
        width: 100%;
		height: 100%;
        top: 0;
        left: 0;
        backdrop-filter: blur(2px);
		position: absolute;
	}

	#about:target {
        display: block;		
	}

    .about-center {
	    position: relative;
		display: flex;
		margin-left: auto;
		margin-right: auto;
		max-width: 607px;
        height: 100%;

        justify-content: center;
        align-content: center;

        pointer-events: none;
    }

    .about-container {
        display: flex;
        position: relative;
        flex-direction: column;
        justify-content: start;

        width: 351px;
        height: fit-content;
        margin-top: 40%;

        padding: 8 24 24 24;

        background-color: white;
        border-radius: 20;

        box-shadow: 2px 2px 4px rgb(0 0 0 / 25%);

        pointer-events: all;
    }

    .about-close {
        display: flex;
        position: absolute;
        top: 8px;
        right: 8px;
    }

    .about-center-close {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: hidden;
        cursor: default;
    }

</style>