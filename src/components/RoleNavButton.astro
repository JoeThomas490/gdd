---
import { GetRoleIcon, type Role } from "../globals"

interface Props {
    role : Role;
    title : string
} 

const { role, title } = Astro.props


const { Icon, iconBg, dest, rotation } = GetRoleIcon(role);
---

<a class="rolenav-button" href={dest}>
    <div class="rolenav-icon-container">
        <div class="rolenav-icon">
            <Icon></Icon>
        </div>
    </div>
    <h2>
        {title}
    </h2>
</a>



<style define:vars={{iconBg, rotation}}>

.rolenav-button {
    width: fit-content;
    height: 42px;

    display: flex;
    flex-direction: row;
    justify-content: center;
    align-content: end;

    text-decoration: none;

    margin-bottom: 10px;
}

a {
    text-decoration: none;
    color: inherit;
}

a:hover {
    cursor: pointer;
}

.rolenav-icon-container {
    background-color: var(--iconBg);
    width:40px;
    height:40px;

    display: flex;
    align-content: center;
    justify-content: center;

    transform:rotate(var(--rotation));
}

.rolenav-icon {
    display: flex;
    align-self: center;
}

h2 {
    font-family: var(--font-crimson);
    font-size: 28px;
    font-weight: 400;
    margin: 0;
    margin-left: 10px;
    align-self: end;
}

a:hover h2 {
    text-decoration: underline;
}

</style>
