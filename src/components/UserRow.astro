---
import { SquareArrowOutUpRight } from "@lucide/astro"
import UserRowRole from "./UserRowRole.astro";
import type { Role } from "../globals";

interface Props {
    url : string,
    name : string,
    roles : Array<Role>
}

const {url, name, roles } = Astro.props

const cleanseURL = (url: string) => {
	return url.replace('https://', '');
};

const getFavIcon = (url: string) => {
	return `https://www.google.com/s2/favicons?domain_url=${cleanseURL(url)}&sz=28`
}

const cleanURL = cleanseURL(url);
const favIcon = getFavIcon(url)

---


<li>
    <a href={url} target="_blank" class="userrow" data-roles={JSON.stringify(roles)}>
        <div class="userrow-user">
			<div class="userrow-name">
				<img height="28" width="28" src={favIcon} />
				<p>
					{name}
				</p>
			</div>
            <div class="userrow-roles">
                {roles.map(role => (
                    <UserRowRole role={role}/>
                ))}
            </div>
        </div>
        <div class="userrow-website">
            {cleanURL}
            <div class="userrow-website-link-icon">
                <SquareArrowOutUpRight size={12} color='#3B3B3B'/>
            </div>
        </div>
        </a>
</li>


<style>
    li {
		list-style: none;
		width: 100%;
		height: 40px;
		gap: 4px;
		display: none;
	}

	li:not(:last-child) {
		margin-bottom: 8px;
	}

    a:visited {
		text-decoration: none !important;
		
	}

	p {
		margin: 0;
		margin-top: auto;
		margin-bottom: auto;
		margin-left: 10px;
		
		font-family: var(--font-inter);
		font-weight: 400;
	}

	.userrow {
		width: 100%;
		height: 100%;
		padding: 2 8 2 20;
		
		display: flex;
		flex-direction: row;
		flex-grow: 1;
		justify-content: space-between;
		align-content: center;
		text-decoration: none;
		color: #000000;
	}

	.userrow:hover {
		background-color: rgb(255 255 255 / 50%);
		border-radius: 20;
		cursor: pointer;
        box-shadow: 2px 2px 4px rgb(0 0 0 / 25%);
	}

	.userrow:hover .userrow-website {
		text-decoration: underline;
	}

	.userrow-user {
		display: flex;
		flex-direction: row;
		justify-content: start;
		align-content: center;
		align-self: center;
	}

	.userrow-name {
		display: flex;
		flex-direction: row;
		justify-content: start;
		align-content: center;
		align-self: center;
	}

	.userrow-website {
		display:flex;
		flex-direction: row;
		justify-content: end;
		align-self: center;
		align-content: center;

		font-family: var(--font-inter);
		font-weight: 200;
		font-size: 16px;
	}

	.userrow-website-link-icon {
		color: #3B3B3B;
		align-self:flex-start;
		margin-left: 2px;
	}

    .userrow-roles {
        display: flex;
        flex-direction: row;
        justify-content: start;
        margin-left: 10px;
        align-self: center;
    }
</style>