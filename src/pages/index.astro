---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import UserRow from '../components/UserRow.astro';

const gamedevs = await getCollection('gamedevs');
const sortedData = gamedevs.sort((a,b) => {
	if (a.data.name < b.data.name) {
    	return -1;
  	}
  	if (a.data.name > b.data.name) {
    	return 1;
  	}
  	return 0;
});


---

<Layout>
	<main>
		<ul>
			{sortedData.map(gamedev => (
				<UserRow url={gamedev.data.websiteURL} name={gamedev.data.name} roles={gamedev.data.roles}/>
			))}
		</ul>
	</main>
</Layout>

<style>
	main {
		height: 100%;
	}

	ul {
		padding: 0;
	}


</style>

<script>
	console.log(window.location);
	const searchString = new URLSearchParams(window.location.search);
	const searchRole = searchString.get('role');
	const rows = document.getElementsByClassName('userrow');

	for(let row of rows) {
		if(row && row instanceof HTMLElement && row.dataset.roles) {
			const rowRoles = JSON.parse(row.dataset.roles) as Array<string>;
			if(searchRole) {
				if(rowRoles.includes(searchRole) && row.parentElement) {
					row.parentElement.style.display = 'flex';
				}
			} else if(row.parentElement){
				row.parentElement.style.display = 'flex';
			}
		}
	}
</script>

