---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SquareArrowOutUpRight } from '@lucide/astro'

const gamedevs = await getCollection('gamedevs')

const cleanseURL = (url: string) => {
	return url.replace('https://', '');
};

const getFavIcon = (url: string) => {
	return `https://www.google.com/s2/favicons?domain_url=${cleanseURL(url)}&sz=28`
}
---

<Layout>
	<main>
		<ul>
			{gamedevs.map(gamedev => (
				<li>
					<a href={gamedev.data.websiteURL} target="_blank" class="gamedev-row">
						<div class="gamedev-row-user">
							<img height="28" width="28" src={getFavIcon(gamedev.data.websiteURL)} />
							<p>
								{gamedev.data.name}
							</p>
						</div>
						<div class="gamedev-row-website">
							{cleanseURL(gamedev.data.websiteURL)}
							<div class="gamedev-row-website-link-icon">
								<SquareArrowOutUpRight size={12} color='#3B3B3B'/>
							</div>
						</div>
						</a>
				</li>
			))}
		</ul>
	</main>
</Layout>

<style>
	main {
		/* background-color: rgba(255, 0, 0, 0.2); */
		height: 100%;
	}

	ul {
		padding: 0;
	}

	li {
		list-style: none;
		width: 100%;
		height: 40px;
		gap: 4px;
		display: flex;
	}

	li:not(:last-child) {
		margin-bottom: 8px;
	}
	
	a:visited {
		text-decoration: none !important;
		
	}

	p {
		margin: 0;
		margin-top: auto;
		margin-bottom: auto;
		margin-left: 10px;
		
		font-family: var(--font-inter);
		font-weight: 400;
	}

	.gamedev-row {
		width: 100%;
		height: 100%;
		padding: 2 8 2 20;
		
		display: flex;
		flex-direction: row;
		flex-grow: 1;
		justify-content: space-between;
		align-content: center;
		text-decoration: none;
		color: #000000;
	}

	.gamedev-row:hover {
		background-color: rgb(255 255 255 / 50%);
		border-radius: 20;
		cursor: pointer;
	}

	.gamedev-row-user {
		display: flex;
		flex-direction: row;
		justify-content: start;
		align-content: center;
		align-self: center;
	}

	.gamedev-row-website {
		display:flex;
		flex-direction: row;
		justify-content: end;
		align-self: center;
		align-content: center;

		font-family: var(--font-inter);
		font-weight: 200;
		font-size: 16px;
	}

	.gamedev-row-website-link-icon {
		color: #3B3B3B;
		align-self:flex-start;
		margin-left: 2px;
	}

</style>
