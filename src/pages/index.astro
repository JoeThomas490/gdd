---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const gamedevs = await getCollection('gamedevs')
---

<Layout>
	<main>
		<ul>
			{gamedevs.map(gamedev => (
				<li>{gamedev.data.name}</li>
			))}
		</ul>

	</main>
</Layout>

<style>
	main {
		background-color: rgba(255, 0, 0, 0.2);
		height: 100%;
	}
</style>
