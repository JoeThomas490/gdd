---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SquareArrowOutUpRight } from '@lucide/astro'
import UserRow from '../components/UserRow.astro';

const gamedevs = await getCollection('gamedevs')

---

<Layout>
	<main>
		<ul>
			{gamedevs.map(gamedev => (
				<UserRow url={gamedev.data.websiteURL} name={gamedev.data.name} />
			))}
		</ul>
	</main>
</Layout>

<style>
	main {
		height: 100%;
	}

	ul {
		padding: 0;
	}


</style>
